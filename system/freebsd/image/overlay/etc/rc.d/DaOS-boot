#!/bin/sh
# PROVIDE: DaOS_boot
# REQUIRE: mountcritlocal cleanvar
# BEFORE: FILESYSTEMS DaOS_camera
# KEYWORD: shutdown
. /etc/rc.subr
name="DaOS_boot"
rcvar="DaOS_boot_enable"
command="/usr/sbin/daemon"
procname="/usr/sbin/daemon"
pidfile="/var/run/DaOS-boot-supervisor.pid"
start_precmd="DaOS_boot_prepare"
DaOS_boot_prepare() {
    rm -f /var/run/DaOS-boot-native.stop
    echo 20 > /var/run/DaOS-boot-stage
}
command_args="-P ${pidfile} -f -o /var/log/DaOS-boot.log /usr/local/libexec/DaOS-boot /usr/share/DaOS/boot/startup.rgb"
load_rc_config "$name"
: ${DaOS_boot_enable:=NO}
run_rc_command "$1"
