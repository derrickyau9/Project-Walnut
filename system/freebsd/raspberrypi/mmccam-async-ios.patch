 	mtx_assert(&slot->sim_mtx, MA_OWNED);
+
+	if (slot->cam_ios_ccb != NULL) {
+		ccb->ccb_h.status = CAM_BUSY;
+		xpt_done(ccb);
+		return;
+	}
 
 	switch (ccb->ccb_h.func_code) {
 	case XPT_PATH_INQ:
@@ -2698,6 +2741,10 @@
 		break;
 	}
 	case XPT_MMC_SET_TRAN_SETTINGS:
+		ccb->ccb_h.status = CAM_SIM_QUEUED;
+		slot->cam_ios_ccb = ccb;
+		taskqueue_enqueue(taskqueue_thread, &slot->cam_ios_task);
+		return;
