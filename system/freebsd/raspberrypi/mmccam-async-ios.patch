+/*
+ * XPT_MMC_SET_TRAN_SETTINGS is queued, unlike the legacy synchronous opcode.
+ * Platform regulator/firmware/GPIO power operations may sleep. Running them
+ * from sim_action holds both the CAM path and SIM mutexes and can panic when
+ * xpt_register_async contends for the device mutex at early boot.
+ * Match the generic cam/mmc/mmc_sim.c taskqueue completion model instead.
+ */
+static void
+sdhci_cam_ios_task(void *arg, int pending __unused)
+{
+    struct sdhci_slot *slot = arg;
+    union ccb *ccb;
+    int error;
+
+    mtx_lock(&slot->sim_mtx);
+    ccb = slot->cam_ios_ccb;
+    mtx_unlock(&slot->sim_mtx);
+    if (ccb == NULL)
+        return;
+
+    error = sdhci_cam_settran_settings(slot, ccb);
+
+    mtx_lock(&slot->sim_mtx);
+    ccb->ccb_h.status = error == 0 ? CAM_REQ_CMP : CAM_REQ_INVALID;
+    slot->cam_ios_ccb = NULL;
+    mtx_unlock(&slot->sim_mtx);
+    xpt_done(ccb);
+}
+
 void
 sdhci_cam_action(struct cam_sim *sim, union ccb *ccb)
 {
